apiVersion: v1
kind: Secret
metadata:
  name: openfindbearings-api-secrets
  namespace: openfindbearings
type: Opaque
stringData:
  ConnectionStrings__DefaultConnection: "<db_api 连接串>"
  CacheSettings__RedisConnectionString: "<Redis 连接串>"
  # 内部限流豁免令牌（BFF 经 X-Internal-Token 头携带，两侧须一致；API 侧空值=永不豁免 fail-closed）
  Internal__ApiToken: "REPLACE_ME"
  # 对象存储应用账号（MinIO 内建用户，权限限 bucket media 读写，见 doc/07 迁移文档）
  FileStorage__AccessKey: "<minio-app-access-key>"
  FileStorage__SecretKey: "<minio-app-secret-key>"
